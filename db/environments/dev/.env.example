# Variables de la app para DEV.
# Copiar a la raíz del repo como `.env.development.local` (gitignored) y completar.
# Next lo carga solo con `next dev`; `next build` no lo lee.

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase dev (fumwaikjxwrhnuyofdxq) → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://fumwaikjxwrhnuyofdxq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Guarda anti-dev-en-prod (lib/env.ts): ref del proyecto de dev.
SUPABASE_DEV_PROJECT_REF=fumwaikjxwrhnuyofdxq

# Formulario de contacto (Resend). onboarding@resend.dev solo entrega al dueño de la cuenta.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
CONTACT_EMAIL=

# Solo dev: contraseña de la base (psql/scripts locales). La app no la usa.
DB_PWD=
