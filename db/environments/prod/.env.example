# Variables de la app para PROD.
# Se cargan en el hosting (Vercel u otro). Si el build se hace en local, van en
# `.env.production.local` (gitignored). NUNCA se copian valores de dev.
# Las NEXT_PUBLIC_* se inlinean en `next build`: cambiarlas exige un nuevo build.

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://<dominio>

# Supabase prod → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<ref-prod>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Guarda anti-dev-en-prod (lib/env.ts): si la URL de arriba contiene este ref, la app no arranca.
SUPABASE_DEV_PROJECT_REF=fumwaikjxwrhnuyofdxq

# Formulario de contacto (Resend), con un dominio verificado en Resend.
RESEND_API_KEY=
RESEND_FROM=contacto@<dominio>
CONTACT_EMAIL=
